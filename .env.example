# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值(切勿提交 .env)
# 复制:  cp .env.example .env    (Windows: copy .env.example .env)
# ============================================================

# ---------- LLM ----------
# DeepSeek API Key(网关首选供应商,必填)
DEEPSEEK_API_KEY=
# LLM 网关地址(默认指向本地微网关 :8006/v1;所有 LLM 流量必须经网关)
LLM_BASE_URL=http://127.0.0.1:8006/v1

# ---------- 监控 ----------
# Prometheus 地址(告警查询)
PROMETHEUS_BASE_URL=http://127.0.0.1:9090

# ---------- 持久化(可选,生产建议开启) ----------
# Postgres 连接串;配置后 LangGraph 检查点持久化(重启不丢),留空则用内存
# 例: postgresql://aiops:aiops@127.0.0.1:5432/aiops
CHECKPOINTER_DSN=

# ---------- 可观测性(可选,Langfuse) ----------
# 自托管 Langfuse 需在 https://cloud.langfuse.com 或自建实例生成
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:4000
