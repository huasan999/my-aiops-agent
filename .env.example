# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值(切勿提交 .env)
# 用法: cp .env.example .env
# ============================================================

# ---------- LLM ----------
# DeepSeek API Key(必填)
DEEPSEEK_API_KEY=
# LLM 网关地址(所有 LLM 流量必须经网关)
LLM_BASE_URL=http://127.0.0.1:8006/v1

# ---------- 监控 ----------
# Prometheus 地址(宿主映射 19090,容器内 9090)
PROMETHEUS_BASE_URL=http://127.0.0.1:19090

# ---------- 持久化(可选) ----------
# Postgres 连接串,留空用内存检查点
CHECKPOINTER_DSN=

# ---------- 可观测性(可选,LangSmith) ----------
# API Key 在 https://smith.langchain.com 创建
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=my-aiops-agent
